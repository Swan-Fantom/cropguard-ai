# CropGuard Node/Express API — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# HTTP port the Node API listens on.
PORT=4000

# MongoDB connection string.
#  - Local:   mongodb://127.0.0.1:27017/cropguard
#  - Atlas:   mongodb+srv://<user>:<pass>@<cluster>/cropguard
MONGO_URI=mongodb://127.0.0.1:27017/cropguard

# Secret used to sign JWTs. Use a long random string in production
# (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=24c22da0a7c42802574f4cd15303d7a41544c1155d02d64338da6040492c8b9e9b3e7f41b5b8f25c632b656d0567ff0f
# How long an issued token stays valid.
JWT_EXPIRES_IN=7d

# Base URL of the Python FastAPI ML service (Step 2/3). The Node API forwards
# uploaded images here for /predict and /explain.
ML_SERVICE_URL=http://127.0.0.1:8000

# Comma-separated list of browser origins allowed to call this API (the Vite dev
# server + wherever you host the built frontend). Used for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max upload size accepted by the Node API, in megabytes.
MAX_UPLOAD_MB=10
